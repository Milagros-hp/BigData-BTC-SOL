      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "cryptopulse-postgres"
          },
          "rawSql": "WITH events AS (SELECT to_timestamp(as_of_ms/1000.0) AS \"Fecha\",symbol AS \"Activo\",CASE dimension WHEN 'volatility' THEN 'Volatilidad' WHEN 'crash' THEN 'Caída' WHEN 'anomaly' THEN 'Actividad' ELSE 'Divergencia' END AS \"Dimensión\",CASE kind WHEN 'observed' THEN 'Observada' ELSE 'Pronóstico' END AS \"Origen\",CASE severity WHEN 'high' THEN 'ALERTA' ELSE 'VIGILANCIA' END AS \"Estado\",round(value::numeric,3) AS \"Valor\",round(threshold::numeric,3) AS \"Umbral\",explanation AS \"Detalle\" FROM market_signals WHERE triggered AND source_mode='live' AND model_version=(SELECT value FROM runtime_configuration WHERE key='active_model_version') AND (as_of_ms BETWEEN $__unixEpochFrom()::bigint*1000 AND $__unixEpochTo()::bigint*1000) ORDER BY as_of_ms DESC LIMIT 100)\n SELECT * FROM events UNION ALL SELECT NULL,'BTC / SOL','Todas','Estado',CASE WHEN (SELECT count(*) FROM cp_signal_board WHERE kind='forecast' AND age_seconds<=180)=7 THEN 'SIN CRUCES' ELSE 'REVISAR INFERENCIA' END,NULL,NULL,'No hay señales que superen umbrales en el período seleccionado.' WHERE NOT EXISTS(SELECT 1 FROM events)",
          "format": "table",
          "rawQuery": true
        }
      ]
    },
