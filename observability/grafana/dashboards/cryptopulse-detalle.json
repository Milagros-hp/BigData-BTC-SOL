            "type": "postgres",
            "uid": "cryptopulse-postgres"
          },
          "rawSql": "SELECT symbol AS \"Activo\",CASE dimension WHEN 'volatility' THEN 'Volatilidad' WHEN 'crash' THEN 'Caída' WHEN 'anomaly' THEN 'Actividad' ELSE 'Divergencia' END AS \"Dimensión\",CASE kind WHEN 'observed' THEN 'Observada' ELSE 'Pronóstico' END AS \"Origen\",state AS \"Estado\",round(value::numeric,3) AS \"Valor\",round(threshold::numeric,3) AS \"Umbral\",explanation AS \"Interpretación\",action AS \"Qué revisar\" FROM cp_signal_board ORDER BY dimension,symbol,kind",
          "format": "table",
          "rawQuery": true
