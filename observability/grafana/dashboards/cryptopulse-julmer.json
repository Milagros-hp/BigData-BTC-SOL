            "type": "postgres",
            "uid": "cryptopulse-postgres"
          },
          "rawSql": "SELECT replace(symbol,'USDT','') AS \"Activo\",to_timestamp(close_ms/1000.0) AS \"Cierre\",open::double precision AS \"Apertura\",high::double precision AS \"Máximo\",low::double precision AS \"Mínimo\",close::double precision AS \"Cierre USDT\",round(quote_asset_volume::numeric,0) AS \"Volumen USDT\",number_of_trades AS \"Operaciones\" FROM market_candles WHERE source_mode<>'replay' ORDER BY close_ms DESC,symbol LIMIT 8",
