          "rawSql": "SELECT CASE k WHEN 'rmse' THEN 'RMSE (menos es mejor)' WHEN 'mae' THEN 'MAE (menos es mejor)' WHEN 'pr_auc' THEN 'PR-AUC (más es mejor)' WHEN 'brier' THEN 'Brier (menos es mejor)' WHEN 'precision' THEN 'Precisión en el umbral' ELSE 'Recall en el umbral' END AS \"Métrica\",round((x.metrics->>k)::numeric,3) AS \"Modelo\",round((b.metrics->>k)::numeric,3) AS \"Referencia\" FROM unnest(ARRAY['pr_auc','brier','precision','recall']) k CROSS JOIN model_metrics x JOIN model_metrics b ON b.dimension=x.dimension AND b.model_version=x.model_version AND b.split='test_baseline' WHERE x.dimension='crash' AND x.split='test_deployed' AND x.model_version=(SELECT value FROM runtime_configuration WHERE key='active_model_version')",
