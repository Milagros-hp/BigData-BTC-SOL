        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "vertical"
      },
      "datasource": {
        "type": "postgres",
        "uid": "cryptopulse-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "cryptopulse-postgres"
          },
          "rawSql": "SELECT now() AS time,replace(symbol,'USDT','') AS metric,100*value/NULLIF(threshold,0) AS value FROM cp_signal_board WHERE kind='forecast' AND dimension='crash' ORDER BY symbol",
          "format": "time_series",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 111,
      "title": "Pronóstico en el tiempo",
      "type": "timeseries",
      "gridPos": {
        "x": 6,
        "y": 28,
        "w": 18,
        "h": 8
      },
      "description": "Punteada: pronóstico. Continua: observada. Puntos: lo que pasó después.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Pendiente",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "spanNulls": false,
            "showPoints": "never",
            "lineInterpolation": "smooth",
            "axisGridShow": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^BTC(USDT)?( ·.*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F2A65A"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^SOL(USDT)?( ·.*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#4C9BE8"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^BTC-SOL.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#B48EF0"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*(pronóstico|referencia)$"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    6
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*realidad futura$"
            },
            "properties": [
              {
                "id": "custom.drawStyle",
                "value": "points"
              },
              {
                "id": "custom.pointSize",
                "value": 6
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "datasource": {
        "type": "postgres",
        "uid": "cryptopulse-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "cryptopulse-postgres"
          },
          "rawSql": "SELECT to_timestamp(as_of_ms/1000.0) AS time,replace(symbol,'USDT','')||' · pronóstico' AS metric,forecast AS value FROM predictions WHERE dimension='crash' AND source_mode='live' AND model_version=(SELECT value FROM runtime_configuration WHERE key='active_model_version') AND (as_of_ms BETWEEN $__unixEpochFrom()::bigint*1000 AND $__unixEpochTo()::bigint*1000) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true
        }
      ]
    },
