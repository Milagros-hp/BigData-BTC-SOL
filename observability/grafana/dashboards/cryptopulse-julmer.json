            "type": "postgres",
            "uid": "cryptopulse-postgres"
          },
          "rawSql": "SELECT to_timestamp(as_of_ms/1000.0) AS \"Emitido\",replace(symbol,'USDT','') AS \"Activo\",round(100*forecast::numeric,1) AS \"Probabilidad %\",round(100*baseline::numeric,1) AS \"Referencia %\",CASE WHEN alert THEN 'Sí' ELSE 'No' END AS \"¿Alertó?\",CASE WHEN actual>=1 THEN 'Sí' ELSE 'No' END AS \"¿Ocurrió?\" FROM predictions WHERE dimension='crash' AND source_mode='live' AND model_version=(SELECT value FROM runtime_configuration WHERE key='active_model_version') AND actual IS NOT NULL ORDER BY as_of_ms DESC,symbol LIMIT 10",
          "format": "table",
          "rawQuery": true
        }
      ]
