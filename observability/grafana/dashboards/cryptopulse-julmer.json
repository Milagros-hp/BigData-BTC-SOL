      "options": {
        "mode": "html",
        "content": "<div style=\"display:flex;align-items:center;justify-content:center;flex-wrap:nowrap;height:100%;gap:0\"><span style=\"display:inline-block;padding:8px 8px;border-radius:10px;background:rgba(244,241,234,.07);color:#F4F1EA;text-align:center;min-width:74px\"><b>Binance</b><br><span style=\"font-size:11px\">vela o operación real</span></span><span style=\"color:#C9CED8;font-size:20px;margin:0 3px\">→</span><span style=\"display:inline-block;padding:8px 8px;border-radius:10px;background:rgba(244,241,234,.07);color:#F4F1EA;text-align:center;min-width:74px\"><b>Kafka</b><br><span style=\"font-size:11px\">tópico con contrato</span></span><span style=\"color:#C9CED8;font-size:20px;margin:0 3px\">→</span><span style=\"display:inline-block;padding:8px 8px;border-radius:10px;background:rgba(244,241,234,.07);color:#F4F1EA;text-align:center;min-width:74px\"><b>Spark</b><br><span style=\"font-size:11px\">valida y calcula</span></span><span style=\"color:#C9CED8;font-size:20px;margin:0 3px\">→</span><span style=\"display:inline-block;padding:8px 8px;border-radius:10px;background:#E5534B;color:#12182B;text-align:center;min-width:74px\"><b>Modelo</b><br><span style=\"font-size:11px\">pronóstico cada minuto</span></span><span style=\"color:#C9CED8;font-size:20px;margin:0 3px\">→</span><span style=\"display:inline-block;padding:8px 8px;border-radius:10px;background:rgba(244,241,234,.07);color:#F4F1EA;text-align:center;min-width:74px\"><b>PostgreSQL</b><br><span style=\"font-size:11px\">guarda y evalúa</span></span><span style=\"color:#C9CED8;font-size:20px;margin:0 3px\">→</span><span style=\"display:inline-block;padding:8px 8px;border-radius:10px;background:rgba(244,241,234,.07);color:#F4F1EA;text-align:center;min-width:74px\"><b>Grafana</b><br><span style=\"font-size:11px\">lo que ves</span></span></div>"
