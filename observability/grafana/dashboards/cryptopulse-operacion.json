    {
      "id": 78,
      "title": "Kafka · mensajes por minuto por tópico",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 10
      },
      "description": "Regla de grabación de Prometheus: tasa de 5 minutos de los offsets, llevada a mensajes por minuto. Las operaciones son ~99 % del volumen.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Pendiente",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "spanNulls": false,
            "showPoints": "never",
            "lineInterpolation": "smooth"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*btcusdt$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F2A65A"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*solusdt$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#4C9BE8"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^market\\.klines.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    6
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cryptopulse-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cryptopulse:kafka_mensajes_por_minuto",
          "instant": false,
          "legendFormat": "{{topic}}"
        }
      ]
    },
